# ====================================================================
# K3LEARN — ENVIRONMENT VARIABLES CONFIGURATION
# ====================================================================

# 1. URL Proyek Supabase Anda (Didapat dari Dashboard Supabase -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anonymous Key Supabase (Aman digunakan di browser klien)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_supabase_anon_key_here

# CATATAN KEAMANAN PENTING:
# JANGAN PERNAH menaruh "service_role" secret key Supabase di file ini atau di sisi frontend!
# Kunci rahasia service_role hanya untuk backend server yang terlindungi.
